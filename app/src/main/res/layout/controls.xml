<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout android:layout_width="145dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
        <TextView android:id="@+id/exploreTextView" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="TASK 1/2" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/exploreTimeTextView2" android:layout_width="match_parent" android:layout_height="30dp" android:background="@color/white" android:gravity="center" android:text="00:00" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
        <ToggleButton android:id="@+id/exploreToggleBtn2" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:backgroundTint="@color/lightRed" android:textOff="TASK 1 START" android:textOn="STOP" android:textColor="@color/black" />
        <Button android:id="@+id/explorePauseBtn" android:layout_width="match_parent" android:layout_height="38dp" android:backgroundTint="@color/colorYellow" android:text="PAUSE" android:textColor="@color/black" />
        <Button android:id="@+id/sendObstaclesButton" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="4dp" android:backgroundTint="@color/lightRed" android:text="SEND MAP" android:textColor="@color/black" android:textSize="11sp" android:contentDescription="Send obstacle map to robot" />
        <ImageButton android:id="@+id/exploreResetImageBtn2" style="@style/Widget.AppCompat.ImageButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center_horizontal" android:background="@color/transparent" />
    </LinearLayout>

    <LinearLayout android:layout_width="145dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
        <Button android:id="@+id/practiceTasksBtn" android:layout_width="match_parent" android:layout_height="38dp" android:backgroundTint="@color/lightRed" android:text="PRACTICE" android:textColor="@color/black" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/fastestTimeTextView2" android:layout_width="match_parent" android:layout_height="30dp" android:background="@color/white" android:gravity="center" android:text="00:00" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
        <ToggleButton android:id="@+id/fastestToggleBtn2" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:backgroundTint="@color/lightRed" android:textOff="TASK 2 START" android:textOn="STOP" android:textColor="@color/black" />
        <Button android:id="@+id/fastestPauseBtn" android:layout_width="match_parent" android:layout_height="38dp" android:backgroundTint="@color/colorYellow" android:text="PAUSE" android:textColor="@color/black" />
        <ImageButton android:id="@+id/fastestResetImageBtn2" style="@style/Widget.AppCompat.ImageButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center_horizontal" android:background="@color/transparent" />
    </LinearLayout>

    <include layout="@layout/movement_controls" />
</LinearLayout>
